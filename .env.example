# Synthetic local development only. Never reuse production credentials here.
SOCIETY_DATABASE_URL=postgresql://society:local-demo-only@localhost:55433/society
SOCIETY_CREATOR_TOKEN=replace-with-a-long-random-local-secret
# Mock inference is the default. Live Azure needs provider, paid flag and resource below.
SOCIETY_PROVIDER=mock
LANGSMITH_TRACING=false
# Azure AI Foundry adapter (opt-in). Names are installation-specific; never commit real values.
# Entra (az login or managed identity) is the only supported authentication; API keys are refused.
# SOCIETY_PAID_INFERENCE_ENABLED=true
# SOCIETY_AZURE_RESOURCE=YOUR-RESOURCE
SOCIETY_AZURE_AUTH=entra
# Four separately installed Slack bot identities (no live connection yet).
SOCIETY_SLACK_CHANNEL_ID=YOUR-COUNCIL-CHANNEL
# SOCIETY_SLACK_HISTORIAN_BOT_TOKEN=
# SOCIETY_SLACK_HISTORIAN_APP_TOKEN=
# Repeat STRATEGIST, SKEPTIC, SCORER as documented in docs/ARCHITECTURE.md.
# Optional read-only GitHub scope. Leave empty to keep all live GitHub reads disabled.
# SOCIETY_GITHUB_ORG=YOUR-ORG
# SOCIETY_GITHUB_REPO_PREFIX=YOUR-REPO-PREFIX-
# SOCIETY_GITHUB_CONTEXT_REPO=
# SOCIETY_GITHUB_DEPLOYMENTS_REPO=
# SOCIETY_LOCAL_REPO_ROOT=
# SOCIETY_ECOSYSTEM_DESCRIPTION=
# SOCIETY_GITHUB_TOKEN=
# SOCIETY_NOTION_TOKEN=
