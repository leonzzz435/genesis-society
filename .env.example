# Synthetic local development only. Never reuse production credentials here.
SOCIETY_DATABASE_URL=postgresql://society:local-demo-only@localhost:55433/society
SOCIETY_CREATOR_TOKEN=replace-with-a-long-random-local-secret
# Live inference is deliberately unavailable in this starter.
SOCIETY_PROVIDER=mock
LANGSMITH_TRACING=false
# Future Azure adapter. Deployment names are installation-specific.
SOCIETY_AZURE_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
SOCIETY_AZURE_DEPLOYMENT=YOUR-DEPLOYMENT
SOCIETY_AZURE_AUTH=entra
# SOCIETY_AZURE_API_KEY=
# Future four separately installed Slack bot identities (no live connection yet).
SOCIETY_SLACK_CHANNEL_ID=YOUR-COUNCIL-CHANNEL
# SOCIETY_SLACK_HISTORIAN_BOT_TOKEN=
# SOCIETY_SLACK_HISTORIAN_APP_TOKEN=
# Repeat STRATEGIST, SKEPTIC, SCORER as documented in docs/ARCHITECTURE.md.
# SOCIETY_GITHUB_TOKEN=
# SOCIETY_NOTION_TOKEN=
